# Temporal Code Reviewer - Environment Variables

# OpenRouter API Key (REQUIRED for LLM reviews)
# Get your API key from: https://openrouter.ai/keys
OPENROUTER_API_KEY=your-openrouter-api-key-here

# GitHub Token (optional, required for GitHub integration)
# Generate at: https://github.com/settings/tokens
# Required permissions: repo (for PR reads/reviews), read:org
GITHUB_TOKEN=ghp_your-token-here

# Admin API Token (optional, recommended when exposed to network)
# All /api/* endpoints require "Authorization: Bearer <token>" when set
ADMIN_API_TOKEN=your-admin-token

# Webhook Secret (required when webhook.enabled=true)
# Set the same value in your GitHub webhook configuration
WEBHOOK_SECRET=your-webhook-secret

# Temporal Server Address (optional)
# Default: localhost:7233
# TEMPORAL_ADDRESS=localhost:7233
